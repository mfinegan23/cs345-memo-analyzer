AZURE_SPEECH_KEY=your-speech-key-here
AZURE_SPEECH_REGION=northcentralus
AZURE_LANGUAGE_KEY=your-language-key-here
AZURE_LANGUAGE_ENDPOINT=https://your-language-resource.cognitiveservices.azure.com/
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=...;IngestionEndpoint=...;LiveEndpoint=...;ApplicationId=..."

# Optional
# INTERNAL_TOKEN=any-long-random-string      # required header for /transcribe when deployed
# NEG_SENTENCE_THRESHOLD=0.80                # escalation rule 2: negative score cutoff
# NEG_SENTENCE_COUNT=2                       # escalation rule 2: how many sentences
